---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Not found" description="Page not found.">
  <div class="container center" style="padding:5rem 0">
    <p class="eyebrow">404</p>
    <h1 style="font-size:clamp(2rem,6vw,3.5rem);margin:.4rem 0">This road isn't paved yet.</h1>
    <p class="muted" style="max-width:34rem;margin:0 auto 1.5rem">
      The page you're looking for doesn't exist or has moved.
    </p>
    <a class="btn btn-primary" href="/">Back home <Icon name="arrow" size={16} /></a>
  </div>
</BaseLayout>
